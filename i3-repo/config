# ═══════════════════════════════════════════════════════════════════════════
# 🎨 BASIC SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

set $mod Mod1
bindsym F4 kill
font pango:Choco Cooky 12
#font losevka Font 20

# Color variables (defined early for use throughout config)

title_align center
gaps bottom 26
gaps right 719
gaps left 20
gaps top 10
smart_gaps off
new_window none
new_float none

# ═══════════════════════════════════════════════════════════════════════════
# 🎨 MONOCHROME BLACK & WHITE 
# ═══════════════════════════════════════════════════════════════════════════
set $bg-light       #0e0e1a
set $bg-medium      #07070e
set $bg-darker      #07070e
set $accent         #180208
set $accent-dim     #bbbbbb
set $text-primary   #ffffff
set $text-secondary #bbbbbb
set $text-muted     #555555
set $urgent         #ffffff
set $indicator      #ffffff
set $stale          #bbbbbb
client.focused          $accent       $bg-medium     $text-primary   $accent-dim   $accent
client.focused_inactive $bg-darker       $bg-darker     #00000000       $text-muted   $bg-light
client.unfocused         $bg-darker   $bg-darker     #00000000       $bg-darker    $bg-darker
client.urgent           $urgent       $urgent        $text-primary   $urgent       $urgent
client.placeholder      $bg-darker    $bg-medium     $text-muted     $bg-darker    $bg-darker
client.background       $bg-medium
# ═══════════════════════════════════════════════════════════════════════════
# 🪟 WINDOW APPEARANCE
# ═══════════════════════════════════════════════════════════════════════════
default_border 1pixel 
default_floating_border normal 3
smart_borders no_gaps
default_orientation auto
for_window [urgent=latest] focus
workspace_layout tabbed
#tiling_drag_threshold 20
for_window [all] title_format "  <i>%title </i> "
bindsym Mod4+g exec --no-startup-id ~/i3-repo/scripts/bin/float-expose.sh
bindsym Mod4+q exec --no-startup-id ~/i3-repo/scripts/bin/float-peek.sh
#bindsym Mod4+g exec --no-startup-id ~/i3-repo/scripts/bin/tiled-expose.sh
bindsym Mod4+h exec --no-startup-id ~/i3-repo/scripts/bin/window-jump.sh
bindsym Mod4+Shift+h exec --no-startup-id ~/i3-repo/scripts/bin/zone-swap.sh
bindsym Mod4+Shift+g exec --no-startup-id ~/i3-repo/scripts/bin/personality-swap.sh
bindsym Mod4+Shift+z exec --no-startup-id ~/i3-repo/scripts/bin/float-hide-all.sh
bindsym Mod4+Shift+i exec --no-startup-id ~/i3-repo/scripts/bin/float-pin.sh
bindsym Mod4+Shift+k exec --no-startup-id ~/i3-repo/scripts/bin/float-graveyard.sh --pick
bindsym Mod4+Shift+v exec --no-startup-id ~/i3-repo/scripts/bin/focus-lock.sh
# ═══════════════════════════════════════════════════════════════════════════
# 🚀 WORKSPACES
# ═══════════════════════════════════════════════════════════════════════════
#bindsym $mod+d exec dmenu_run
bindsym $mod+d exec --no-startup-id ~/i3-repo/scripts/bin/dmenu-run
bindsym $mod+comma exec i3-input -F 'rename workspace to "%s"' -P 'Rename: '
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

workspace_auto_back_and_forth yes

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

bindsym Mod4+Tab workspace next
bindsym Mod4+Shift+Tab workspace prev

# ═══════════════════════════════════════════════════════════════════════════
# 🧭 FOCUS & NAVIGATION
# ═══════════════════════════════════════════════════════════════════════════

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+i focus up
bindsym $mod+l focus right


bindsym mod4+i exec --no-startup-id "i3-msg focus up && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"
bindsym mod4+j exec --no-startup-id "i3-msg focus left && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"
bindsym mod4+k exec --no-startup-id "i3-msg focus down && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"
bindsym mod4+l exec --no-startup-id "i3-msg focus right && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"
bindsym $mod+Tab exec --no-startup-id "i3-msg focus right && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"
bindsym $mod+Shift+Tab exec --no-startup-id "i3-msg focus left && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"

#bindsym $mod+shift+Tab exec --no-startup-id "i3-msg focus down && xdotool mousemove --window $(xdotool getwindowfocus) --sync 50% 50%"

bindsym $mod+a focus parent
bindsym $mod+p focus child

bindsym Mod4+m focus output up

bindsym $mod+Shift+greater focus output next
bindsym $mod+Shift+less focus output prev
bindsym $mod+Ctrl+Shift+greater move workspace to output next
bindsym $mod+Ctrl+Shift+less move workspace to output prev
exec_always --no-startup-id dunst
# Consolidated dialog floating rules
for_window [window_role="GtkFileChooserDialog"] floating enable, sticky enable, focus, move position center
for_window [window_type="dialog"]               floating enable, sticky enable, focus, move position center
for_window [window_role="dialog"]               floating enable, sticky enable, focus, move position center
for_window [window_role="pop-up"]               floating enable, sticky enable, focus, move position center
for_window [window_role="task_dialog"]          floating enable, sticky enable, focus, move position center
for_window [window_type="popup_menu"]           floating enable, focus

focus_follows_mouse no
focus_on_window_activation focus
exec --no-startup-id keynav
exec --no-startup-id ~/i3-repo/scripts/bin/picom --config ~/.config/picom/picom.conf -b --log-file /tmp/picom.log

popup_during_fullscreen leave_fullscreen
force_display_urgency_hint 0 ms

# ═══════════════════════════════════════════════════════════════════════════
# 📐 LAYOUTS
# ═══════════════════════════════════════════════════════════════════════════

bindsym $mod+h split h
bindsym $mod+e layout toggle split
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split tabbed
bindsym $mod+f fullscreen toggle
bindsym F9 exec --no-startup-id ~/i3-repo/scripts/i3/cycle-quick.sh
bindsym F10 exec --no-startup-id ~/i3-repo/scripts/i3/cycle-quick.sh reverse
bindsym $mod+Mod4+m exec --no-startup-id ~/i3-repo/scripts/i3/mark-quick.sh
bindsym $mod+Mod4+shift+m exec --no-startup-id ~/i3-repo/scripts/i3/unmark-focused.sh
bindsym Mod4+F10 exec --no-startup-id ~/i3-repo/scripts/bin/mark-unmarked.sh

# Create window group (pick marked windows, name it): Mod4+a
#bindsym Mod4+a exec --no-startup-id ~/i3-repo/scripts/i3/new-group.sh
# Cycle through active group: Mod4+shift+a
bindsym Mod4+shift+a exec --no-startup-id ~/i3-repo/scripts/i3/cycle-group.sh
# Edit group: Mod4+Ctrl+a
bindsym Mod4+ctrl+a exec --no-startup-id ~/i3-repo/scripts/i3/edit-window-group.sh
bindsym F1 focus mode_toggle
#bindsym Mod4+v exec ~/i3-repo/scripts/bin/cursor-jump.sh
bindsym Mod4+v exec --no-startup-id ~/i3-repo/scripts/bin/float-trail.sh

# ═══════════════════════════════════════════════════════════════════════════
# 🪟 WINDOW MOVEMENT
# ═══════════════════════════════════════════════════════════════════════════

bindsym $mod+Shift+j move left 15
bindsym $mod+Shift+k move down 15
bindsym $mod+Shift+i move up 15
bindsym $mod+Shift+l move right 15

bindsym $mod+x kill

