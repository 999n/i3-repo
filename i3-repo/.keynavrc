# --- NEW: Absolute Pixel Nudges (Breaking keynav's proportional cuts) ---
# Keynav's cuts shrink the box relative to its current size (Zeno's paradox),
# making it extremely inefficient for closing a tiny 15px gap. 
# We break out of this by using fixed-pixel hardware mouse movements via xdotool.

# Macro Nudges (15 pixels) - Jump close to boundaries
alt+Up sh "xdotool mousemove_relative -- 0 -15"
alt+Down sh "xdotool mousemove_relative -- 0 15"
alt+Left sh "xdotool mousemove_relative -- -15 0"
alt+Right sh "xdotool mousemove_relative -- 15 0"

# Medium Nudges (5 pixels) - Final inching
shift+Up sh "xdotool mousemove_relative -- 0 -5"
shift+Down sh "xdotool mousemove_relative -- 0 5"
shift+Left sh "xdotool mousemove_relative -- -5 0"
shift+Right sh "xdotool mousemove_relative -- 5 0"

# Micro Nudges (1 pixel) - Pixel-perfect target acquisition
ctrl+Up sh "xdotool mousemove_relative -- 0 -1"
ctrl+Down sh "xdotool mousemove_relative -- 0 1"
ctrl+Left sh "xdotool mousemove_relative -- -1 0"
ctrl+Right sh "xdotool mousemove_relative -- 1 0"

# --- Snap to Clickable Element (computer vision) ---
comma sh "~/bin/keynav-snap.sh",warp

# ═══════════════════════════════════════════════════════════════════════
# MACROS (record / playback)
# ═══════════════════════════════════════════════════════════════════════
# Your 'clear' at the top wiped keynav's built-in record/playback defaults.
# These bindings restore them.
#
# IMPORTANT: i3's $mod is Mod1 (Alt), so plain alt+X keys are TAKEN by i3.
# All added hotkeys therefore use alt+ctrl(+shift) — verified free via
# XGrabKey probing.
#
#   RECORD a macro:   alt+ctrl+r → press a free key (e.g. alt+z) → do stuff
#                     → alt+ctrl+r again to stop
#   PLAYBACK a macro: alt+ctrl+p → press the key you recorded to (e.g. alt+z)
#
# Recorded macros are saved to ~/.keynav_macros so they survive restarts.
# NOTE: record/playback only works while keynav is in interactive mode
#       (after pressing any key bound to 'start', e.g. ctrl+F1).
#
y record ~/.keynav_macros
0 playback

# ═══════════════════════════════════════════════════════════════════════
# QUICK SPOTS — jump to 2–3 known screen coordinates instantly
# ═══════════════════════════════════════════════════════════════════════
# These are global hotkeys (they include 'start' so they work from anywhere).
#
# TO SET UP YOUR COORDINATES:
#   1. Position your cursor over the target element (e.g. the Download button
#      on WhatsApp Web, the Next-arrow, the file-browser delete area, etc.)
#   2. Run in a terminal:  xdotool getmouselocation
#   3. Edit the X Y values below to match.
#   Or: press ctrl+F1 to enter keynav, navigate to the spot, press alt+ctrl+d
#   and the coordinates will pop up as a notification.
#
# The example coordinates below assume a 1920×1080 display.

# Spot 1 — typical browser action button (upper area)
alt+ctrl+shift+1 start,sh "xdotool mousemove 1500 300",end
# Spot 2 — secondary button (e.g. "next" arrow, slightly to the right)
alt+ctrl+shift+2 start,sh "xdotool mousemove 1620 300",end
# Spot 3 — lower area (e.g. file browser, bottom toolbar)
alt+ctrl+shift+3 start,sh "xdotool mousemove 960 800",end

# Jump to spot AND click — for when you know the exact spot you want
# (no need to enter keynav mode first)
alt+ctrl+shift+4 start,sh "xdotool mousemove 1500 300 click 1",end
alt+ctrl+shift+5 start,sh "xdotool mousemove 1620 300 click 1",end
alt+ctrl+shift+6 start,sh "xdotool mousemove 960 800 click 1",end

# ═══════════════════════════════════════════════════════════════════════
# CTRL+CLICK
# ═══════════════════════════════════════════════════════════════════════
# keynav's 'click' command has no modifier support, and 'xdotool click
# ctrl+1' fails on xdotool 3.x. This script uses Python-Xlib + XTEST to
# genuinely hold Ctrl, click, and release.
#
# Usage:  keynav-ctrlclick.sh [X Y] [button]
#   with no args → ctrl+click at current cursor position
#   with X Y    → move to coords, then ctrl+click
#   third arg   → button number (1=left default, 2=middle, 3=right)
#
# Bindings below include 'start' so they work globally (single keypress
# from anywhere, without entering keynav mode first).
alt+ctrl+v start,sh "~/bin/keynav-ctrlclick.sh",end              # ctrl+click at cursor
alt+ctrl+shift+v start,sh "~/bin/keynav-ctrlclick.sh 1500 300",end # ctrl+click at spot 1
alt+ctrl+shift+b start,sh "~/bin/keynav-ctrlclick.sh 1620 300",end # ctrl+click at spot 2

# ═══════════════════════════════════════════════════════════════════════
# HOP SCRIPT — repeat a multi-spot click sequence N times
# ═══════════════════════════════════════════════════════════════════════
# Edit ~/bin/keynav-hop.sh to define your spot list (coordinates + buttons).
# Then bind a key to run it with a count:
#
#   alt+ctrl+h   →  hops through all defined spots once
#   alt+ctrl+j   →  hops through all defined spots 10 times
#   alt+ctrl+k   →  hops through all defined spots 50 times
#   alt+ctrl+l   →  hops through all defined spots 200 times (batch)
#
alt+ctrl+h start,sh "~/bin/keynav-hop.sh 1",end
alt+ctrl+j start,sh "~/bin/keynav-hop.sh 10",end
alt+ctrl+k start,sh "~/bin/keynav-hop.sh 50",end
alt+ctrl+l start,sh "~/bin/keynav-hop.sh 200",end  # batch mode

# ═══════════════════════════════════════════════════════════════════════
# COORDINATE DISCOVERY — show current cursor position as a notification
# ═══════════════════════════════════════════════════════════════════════
# Position cursor (via keynav navigation or mouse), then press alt+ctrl+d
# to see the absolute screen coordinates in a notification.
alt+ctrl+d start,sh "~/bin/keynav-discover.sh 2>/dev/null",end

F3 start,grid 1x1,warp,record ~/.keynav_macros
shift+F3 start,grid 1x1,warp,playback

# ═══════════════════════════════════════════════════════════════════════
# MEDIA KEY GLOBAL TRIGGERS — repurposed idle keys
# Each includes 'start' so it's grabbed globally (no need to be in keynav mode).
# ═══════════════════════════════════════════════════════════════════════

# F13 (was XF86HomePage) — jump to top-left quadrant (taskbar, window tabs, etc.)
F13    start,grid 4x4,cut-left,cut-up,warp

# F14 (was XF86Mail) — jump to top-right quadrant (notifications, tray, close buttons)
F14    start,grid 4x4,cut-right,cut-up,warp

# F15 (was XF86Calculator) — jump to bottom-right quadrant (status bars, scrollbars)
F15    start,grid 4x4,cut-right,cut-down,warp

# F16 (was XF86Sleep) — jump to screen center for fine-navigation
F16    start,grid 1x1,cut-left 0.75,cut-right 0.667,cut-up 0.75,cut-down 0.667,warp

# F17 (was XF86WakeUp) — windowzoom: constrain keynav to current window
F17    start,windowzoom,warp
